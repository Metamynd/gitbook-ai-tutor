# --- Database ---
DATABASE_URL=

# --- App ---
APP_URL=http://localhost:3000

# --- Product identity (this deployment's branding, kept out of code so
# the same codebase can tutor any GitBook-hosted product) ---
TUTOR_PRODUCT_NAME=Your Product
TUTOR_NAME=Your Product Tutor

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507

# --- STT (Phase 2) ---
STT_PROVIDER=openrouter
STT_MODEL=

# --- Knowledge: GitBook MCP ---
# Any GitBook-hosted docs site's MCP integration, at <domain>/~gitbook/mcp.
# Point this at your own GitBook space's docs domain.
GITBOOK_MCP_URL=https://docs.your-product.example.com/~gitbook/mcp
GITBOOK_MCP_TRANSPORT=http
GITBOOK_MCP_API_KEY=

# --- Curriculum generator (scripts/generate-curriculum.mjs) ---
# Bootstraps content/curriculum + content/vocabulary + content/learning-paths
# from the configured GitBook by sampling real pages and asking the LLM to
# propose a taxonomy. Re-run whenever GITBOOK_MCP_URL changes.
CURRICULUM_GENERATOR_SEED_QUERIES=overview,getting started,architecture,core concepts,quickstart
CURRICULUM_GENERATOR_MAX_PAGES=15
CURRICULUM_GENERATOR_MODEL=

# --- TTS (Phase 3, ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
TTS_AUTO_PLAY=false

# --- Governance (passthrough — always ALLOW — until you wire in a real
# governance provider) ---
GOVERNANCE_PROVIDER=passthrough

# --- Session summarization (see config/tutor.config.ts) ---
# strategy: "turns" | "tokens" | "hybrid" (fires when either threshold is exceeded)
SESSION_SUMMARY_STRATEGY=hybrid
SESSION_SUMMARY_TRIGGER_TURNS=10
SESSION_SUMMARY_TRIGGER_TOKENS=3000

# --- Cost tracking ---
ENABLE_COST_TRACKING=true

# --- Admin ---
ADMIN_EMAILS=
# Shared secret for /admin (Pedagogical Tutor toggle + custom prompt).
# Unset disables the admin settings API entirely.
ADMIN_SETTINGS_TOKEN=
