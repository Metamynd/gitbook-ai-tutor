# Production env for your server — copy to .env.production alongside
# docker-compose.yml (NEVER commit the real file; deploy.yml checks it
# exists and fails the deploy if it's missing).
#
# Read by TWO services in docker-compose.yml: the tutor app, and the
# bundled Postgres container (POSTGRES_USER/PASSWORD/DB below). Keep
# DATABASE_URL's credentials consistent with those.

# --- Database (bundled Postgres container, service name "postgres") ---
POSTGRES_USER=tutor
POSTGRES_PASSWORD=
POSTGRES_DB=ai_tutor
DATABASE_URL=postgresql://tutor:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/ai_tutor

# --- App ---
APP_URL=https://tutor.your-domain.example.com

# --- Product identity ---
TUTOR_PRODUCT_NAME=Your Product
TUTOR_NAME=Your Product Tutor

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507

# --- STT (Phase 2 — not yet built) ---
STT_PROVIDER=openrouter
STT_MODEL=

# --- Knowledge: GitBook MCP ---
GITBOOK_MCP_URL=https://docs.your-product.example.com/~gitbook/mcp
GITBOOK_MCP_TRANSPORT=http
GITBOOK_MCP_API_KEY=

# --- Curriculum generator (run manually, not part of the deploy) ---
CURRICULUM_GENERATOR_SEED_QUERIES=overview,getting started,architecture,core concepts,quickstart
CURRICULUM_GENERATOR_MAX_PAGES=15
CURRICULUM_GENERATOR_MODEL=

# --- TTS (Phase 3 — not yet built) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
TTS_AUTO_PLAY=false

# --- Governance ---
GOVERNANCE_PROVIDER=passthrough

# --- Session summarization ---
SESSION_SUMMARY_STRATEGY=hybrid
SESSION_SUMMARY_TRIGGER_TURNS=10
SESSION_SUMMARY_TRIGGER_TOKENS=3000

# --- Cost tracking ---
ENABLE_COST_TRACKING=true

# --- Admin (/admin) ---
ADMIN_EMAILS=
ADMIN_SETTINGS_TOKEN=
